            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/zoological.jpg" alt="Zoological Biscuit" loading="lazy" width="600" height="400" /></div>
                  <h3>Zoological Biscuit</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Cookies & Kids' Favourites</span>
                  <h3>Zoological Biscuit</h3>
                  <p>Fun animal-shaped biscuits.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
      </div>
    </div>
  </section>

  <section class="cat" style="--c:var(--red)">
    <div class="container">
      <header class="cat-head" data-reveal>
        <span class="cat-bar"></span>
        <h2>Gift Tins</h2>
        <span class="cat-count">2 products</span>
      </header>
      <div class="cat-grid" data-reveal-group>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/crispy-delight.jpg" alt="Crispy Delight Assorted" loading="lazy" width="600" height="400" /></div>
                  <h3>Crispy Delight Assorted</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Gift Tins</span>
                  <h3>Crispy Delight Assorted</h3>
                  <p>An assorted biscuit tin for every occasion.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/love-tin.jpg" alt="Assorted Gift Tin" loading="lazy" width="600" height="400" /></div>
                  <h3>Assorted Gift Tin</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Gift Tins</span>
