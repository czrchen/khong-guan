            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/fancy-gem.jpg" alt="Fancy Gems" loading="lazy" width="600" height="400" /></div>
                  <h3>Fancy Gems</h3>
                  <span class="flip-hint">Hover for details ↻</span>
