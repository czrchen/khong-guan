---
import Layout from "../layouts/Layout.astro";
---

<Layout path="/products" title="Products — Central Vista Snacks & Confectionery">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Our products</span>
      <h1 class="page-title" data-split>The full biscuit tin</h1>
      <p class="page-lead" data-reveal>
        Crackers, cream biscuits, cookies and festive gift tins — the complete Khong Guan range
        that's been a part of Malaysian homes for generations.
      </p>
    </div>
  </section>

  <section class="cat" style="--c:var(--red)">
    <div class="container">
      <header class="cat-head" data-reveal>
        <span class="cat-bar"></span>
        <h2>Crackers</h2>
        <span class="cat-count">2 products</span>
      </header>
      <div class="cat-grid" data-reveal-group>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/cream-cracker.jpg" alt="Cream Cracker" loading="lazy" width="600" height="400" /></div>
                  <h3>Cream Cracker</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Crackers</span>
                  <h3>Cream Cracker</h3>
                  <p>The crisp, light classic — a tin-cupboard staple.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/square-puff.jpg" alt="Square Puff" loading="lazy" width="600" height="400" /></div>
                  <h3>Square Puff</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Crackers</span>
                  <h3>Square Puff</h3>
                  <p>Flaky, golden puff crackers.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
      </div>
    </div>
  </section>

  <section class="cat" style="--c:var(--navy)">
    <div class="container">
      <header class="cat-head" data-reveal>
        <span class="cat-bar"></span>
        <h2>Cream Biscuits</h2>
        <span class="cat-count">4 products</span>
      </header>
      <div class="cat-grid" data-reveal-group>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/lemon-puff.jpg" alt="Lemon Puff" loading="lazy" width="600" height="400" /></div>
                  <h3>Lemon Puff</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Cream Biscuits</span>
                  <h3>Lemon Puff</h3>
                  <p>Crisp puff sandwiching zesty lemon cream.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/mega-cream.jpg" alt="Mega Cream" loading="lazy" width="600" height="400" /></div>
                  <h3>Mega Cream</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Cream Biscuits</span>
                  <h3>Mega Cream</h3>
                  <p>Extra-thick cream-filled favourite.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/sultana.jpg" alt="Sultana Biscuit" loading="lazy" width="600" height="400" /></div>
                  <h3>Sultana Biscuit</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Cream Biscuits</span>
                  <h3>Sultana Biscuit</h3>
                  <p>Wholesome biscuits baked with sultanas.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">
                  <div class="pcard-media"><img src="/images/products/durian-cream.jpg" alt="Durian Cream" loading="lazy" width="600" height="400" /></div>
                  <h3>Durian Cream</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Cream Biscuits</span>
                  <h3>Durian Cream</h3>
                  <p>A local twist — fragrant durian cream.</p>
                  <span class="flip-hint light">↩ flip back</span>
