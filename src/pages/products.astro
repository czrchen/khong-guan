              </div>
            </article>
      </div>
    </div>
  </section>

  <section class="cat" style="--c:var(--gold)">
    <div class="container">
      <header class="cat-head" data-reveal>
        <span class="cat-bar"></span>
        <h2>Cookies & Kids' Favourites</h2>
